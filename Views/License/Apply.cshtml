<!-- Modal -->
<div class="modal fade" id="companyModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Company Verification</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label for="companyNumberInput" class="form-label">Company number</label>
                <div class="input-group">
                    <input type="text" id="companyNumberInput" class="form-control text-uppercase" maxlength="50" autocomplete="off" placeholder="Enter company number">
                    <button type="button" id="btnCheckCompany" onclick="getCompany()" class="btn btn-primary">Check company</button>
                </div>
                <div id="companyLookupStatus" class="form-text" aria-live="polite"></div>
                <div id="companyDetailsResult" class="mt-3"></div>
            </div>
        </div>
    </div>
</div>


<script>
    let verifiedCompany = null;
    let companyLookupController = null;

    function handleApplicantTypeChange(select) {
        const isCompany = select.value === "Company";

        if (isCompany) {
            openCompanyModal();
        }

        if (!isCompany) {
            document.getElementById("businessName").readOnly = false;
            document.getElementById("OperationAddress").readOnly = false;
            document.getElementById("companyVerificationSummary").classList.add("d-none");
        }
    }

    function openCompanyModal() {
        const input = document.getElementById("companyNumberInput");
        const modalElement = document.getElementById("companyModal");
        input.value = document.getElementById("companyNumber").value || input.value;

        try {
            if (window.bootstrap && window.bootstrap.Modal) {
                window.bootstrap.Modal.getOrCreateInstance(modalElement).show();
            } else if (window.jQuery && window.jQuery.fn.modal) {
                window.jQuery(modalElement).modal("show");
            } else {
                forceShowCompanyModal(modalElement);
            }
        } catch {
            forceShowCompanyModal(modalElement);
        }

        window.setTimeout(function () { input.focus(); }, 200);
    }

    function closeCompanyModal() {
        const modalElement = document.getElementById("companyModal");

        try {
            if (window.bootstrap && window.bootstrap.Modal) {
                window.bootstrap.Modal.getOrCreateInstance(modalElement).hide();
            } else if (window.jQuery && window.jQuery.fn.modal) {
                window.jQuery(modalElement).modal("hide");
            } else {
                forceHideCompanyModal(modalElement);
            }
        } catch {
            forceHideCompanyModal(modalElement);
        }
    }

    function forceShowCompanyModal(modalElement) {
        modalElement.classList.add("show");
        modalElement.style.display = "block";
        modalElement.removeAttribute("aria-hidden");
        modalElement.setAttribute("aria-modal", "true");
        modalElement.setAttribute("role", "dialog");
        document.body.classList.add("modal-open");

        if (!document.querySelector('[data-company-modal-backdrop="true"]')) {
            const backdrop = document.createElement("div");
            backdrop.className = "modal-backdrop fade show";
            backdrop.setAttribute("data-company-modal-backdrop", "true");
            document.body.appendChild(backdrop);
        }
    }

    function forceHideCompanyModal(modalElement) {
        modalElement.classList.remove("show");
        modalElement.style.display = "none";
        modalElement.removeAttribute("aria-modal");
        modalElement.setAttribute("aria-hidden", "true");
        document.body.classList.remove("modal-open");
        document.querySelectorAll('[data-company-modal-backdrop="true"]').forEach(function (backdrop) {
            backdrop.remove();
        });
    }

    async function getCompany() {
        const companyNumber = document.getElementById("companyNumberInput").value.trim().toUpperCase();
        const checkButton = document.getElementById("btnCheckCompany");
        const result = document.getElementById("companyDetailsResult");
        const status = document.getElementById("companyLookupStatus");

        if (!companyNumber) {
            status.className = "form-text text-danger";
            status.textContent = "Enter a company number.";
            return;
        }

        if (companyLookupController) {
            companyLookupController.abort();
        }
        companyLookupController = new AbortController();
        verifiedCompany = null;
        result.innerHTML = "";
        status.className = "form-text text-muted";
        status.textContent = "Checking the company registry…";
        checkButton.disabled = true;
        checkButton.textContent = "Checking…";

        try {
            const response = await fetch(`/License/details?companyNumber=${encodeURIComponent(companyNumber)}`, {
                headers: { "Accept": "application/json" },
                signal: companyLookupController.signal
            });
            const payload = await readJson(response);
            if (!response.ok || !payload.success) {
                throw new Error(payload.message || "The company could not be verified.");
            }

            verifiedCompany = payload.data;
            renderCompanyDetails(verifiedCompany);
            status.className = "form-text text-success";
            status.textContent = "Company verified. Review the information, then adopt it.";
        } catch (error) {
            if (error.name !== "AbortError") {
                status.className = "form-text text-danger";
                status.textContent = error.message || "The company could not be verified.";
            }
        } finally {
            checkButton.disabled = false;
            checkButton.textContent = "Check company";
        }
    }

    function renderCompanyDetails(companyResult) {
        const info = companyResult.companyInfo;
        const directors = companyResult.directors || [];
        const rows = [
            ["Name", info.name],
            ["Company number", info.companyNumber],
            ["Type", info.type],
            ["City", info.city],
            ["Email", info.email],
            ["Address", info.physicalAddress || info.postalAddress]
        ].map(function (row) {
            return `<tr><th scope="row">${escapeHtml(row[0])}</th><td>${escapeHtml(row[1])}</td></tr>`;
        }).join("");

        const directorRows = directors.length
            ? directors.map(function (director) {
                return `<tr>
                    <td>${escapeHtml(director.names)}</td>
                    <td>${escapeHtml(director.surname)}</td>
                    <td>${escapeHtml(director.nationalId || director.id_no)}</td>
                    <td>${escapeHtml(director.email)}</td>
                    <td>${escapeHtml(director.address)}</td>
                </tr>`;
            }).join("")
            : `<tr><td colspan="5" class="text-muted">No directors were returned by the registry.</td></tr>`;

        document.getElementById("companyDetailsResult").innerHTML = `
            <h5>Company information</h5>
            <div class="table-responsive">
                <table class="table table-bordered table-sm"><tbody>${rows}</tbody></table>
                <h6 class="mt-3">Directors (${directors.length})</h6>
                <table class="table table-striped table-sm">
                    <thead><tr><th>Names</th><th>Surname</th><th>ID No.</th><th>Email</th><th>Address</th></tr></thead>
                    <tbody>${directorRows}</tbody>
                </table>
            </div>
            <div class="d-flex justify-content-end">
                <button type="button" id="btnAdoptCompany" class="btn btn-success" onclick="adoptCompany()">Adopt company and directors</button>
            </div>`;
    }

    async function adoptCompany() {
        if (!verifiedCompany || !verifiedCompany.companyInfo) {
            return;
        }

        const button = document.getElementById("btnAdoptCompany");
        const status = document.getElementById("companyLookupStatus");
        button.disabled = true;
        button.textContent = "Adopting…";
        status.className = "form-text text-muted";
        status.textContent = "Saving the company and synchronising its directors…";

        try {
            const response = await fetch("/License/adopt-company", {
                method: "POST",
                headers: {
                    "Accept": "application/json",
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    applicationId: document.getElementById("applicationId").value || null,
                    companyNumber: verifiedCompany.companyInfo.companyNumber
                })
            });
            const payload = await readJson(response);
            if (!response.ok || !payload.success) {
                throw new Error(payload.message || "The company could not be adopted.");
            }

            document.getElementById("applicationId").value = payload.applicationId;
            document.getElementById("companyNumber").value = payload.companyNumber || "";
            document.getElementById("businessName").value = payload.businessName || "";
            document.getElementById("businessName").readOnly = true;
            document.getElementById("OperationAddress").value = payload.operationAddress || "";
            document.getElementById("OperationAddress").readOnly = true;
            document.getElementById("applicantType").value = "Company";
            document.getElementById("verifiedCompanyText").textContent =
                `Verified company: ${payload.companyNumber} · ${payload.directorCount} director(s) saved`;
            document.getElementById("companyVerificationSummary").classList.remove("d-none");

            status.className = "form-text text-success";
            status.textContent = "Company adopted and directors saved. They will appear on Outlet Information.";
            button.textContent = "Adopted";
            window.setTimeout(function () {
                closeCompanyModal();
            }, 700);
        } catch (error) {
            status.className = "form-text text-danger";
            status.textContent = error.message || "The company could not be adopted.";
            button.disabled = false;
            button.textContent = "Adopt company and directors";
        }
    }

    async function readJson(response) {
        try {
            return await response.json();
        } catch {
            return { success: false, message: "The server returned an unexpected response." };
        }
    }

    function escapeHtml(value) {
        const element = document.createElement("div");
        element.textContent = value || "—";
        return element.innerHTML;
    }

    document.addEventListener("DOMContentLoaded", function () {
        const companyNumber = document.getElementById("companyNumber").value;
        if (companyNumber) {
            document.getElementById("businessName").readOnly = true;
            document.getElementById("OperationAddress").readOnly = true;
        }

        document.getElementById("companyNumberInput").addEventListener("keydown", function (event) {
            if (event.key === "Enter") {
                event.preventDefault();
                getCompany();
            }
        });
    });
</script>
