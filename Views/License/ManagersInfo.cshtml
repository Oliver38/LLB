@{
    Layout = "_LayoutMain";
}

@{ var queryStagePanel = ViewBag.QueryStagePanel as LLB.Models.ViewModel.ApplicantQueryStagePanelViewModel; }
@if (queryStagePanel != null)
{
    @await Html.PartialAsync("_ApplicantQueryStagePanel", queryStagePanel)
}

@if (TempData["error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["error"]</div>
}

<div class="row">
    <div class="card">
        <div class="card-body" id="_step1">

            <div class="card-header">
                <div class="text-center">
                    <h5 class="card-title text-success">@TempData["result"]</h5>
                </div>
                <h5 class="card-title">Manager's Particulars'</h5>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addDirector">Add Manager </button>
                <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#getUserModal">
                    Get Manager Info
                </button>
            </div>


            <table class="table table-responsiveß table-hover table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Surname</th>
                        <th>National Id</th>
                        <th>National Id </th>
                        <th>Fingerpints </th>
                        <th>Form 55</th>
                        @if (queryStagePanel != null)
                        {
                            <th class="text-end">Action</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var manager in ViewBag.ManagersInfo)
                    {
                        <tr>
                            <td>@manager.Name</td>
                            <td>@manager.Surname</td>
                            <td>@manager.NationalId</td>
                            <td>
                                @if (manager.Attachment == "" || manager.Attachment == null)
                                {<a>No Attachment</a> }
                                else
                                {<a target="_blank" href="~/@manager.Attachment"> National Id </a>}
                            </td>
                            <td>
                                @if (manager.Fingerprints == "" || manager.Fingerprints == null)
                                {<a>No Attachment</a>}
                                else
                                {<a target="_blank" href="~/@manager.Fingerprints"> Fingerprints</a>}
                            </td>

                            <td>
                                @if (manager.Form55 == "" || manager.Form55 == null)
                                {<a>No Attachment</a>}
                                else
                                {<a target="_blank" href="~/@manager.Form55"> Form 55</a>}
                            </td>
                            @if (queryStagePanel != null)
                            {
                                <td class="text-end">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editManagerModal"
                                            data-manager-id="@manager.Id"
                                            data-manager-name="@manager.Name"
                                            data-manager-surname="@manager.Surname"
                                            data-manager-national-id="@manager.NationalId"
                                            data-manager-address="@manager.Address">
                                        <i class="bi bi-pencil-square me-1"></i>Edit
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>


            @if (queryStagePanel == null)
            {
                <div class="card-footer">
                    <div class="text-center">
                        @if (ViewBag.ManagersInfo == null)
                        {
                            <a href="/License/OutletInfo?Id=@ViewBag.ApplicationInfo.Id" class="btn btn-warning">Prev</a>
                        }
                        else
                        {
                            <a href="/License/OutletInfo?Id=@ViewBag.ApplicationInfo.Id" class="btn btn-warning">Prev</a>
                            <a href="/License/Attachments?Id=@ViewBag.ApplicationInfo.Id" class="btn btn-success">Next</a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

</div>





<div class="modal fade" id="addDirector" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Adding Manager Details </h5> <h5 class="modal-title" id="feetitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/License/ManagersInfo" enctype="multipart/form-data" method="post">
                <input type="hidden" name="queryMode" value="@(queryStagePanel != null ? "true" : "false")" />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <label for="inputName5" class="form-label">Name</label>
                            <input type="hidden" name="applicationId" class="form-control" value="@ViewBag.ApplicationInfo.Id" id="Id">
                            <input type="text" name="name" class="form-control" id="name" required>
                        </div>
                        <div class="col-md-6">
                            <label for="inputName5" class="form-label">Surname</label>
                            <input type="text" name="surname" class="form-control" id="surname" required>
                        </div>
                        <div class="col-md-12">
                            <label for="inputName5" class="form-label">National Id</label>
                            <input type="text" name="nationalId" class="form-control" id="TownFee" required>
                        </div>
                        <div class="col-md-12">
                            <label for="inputName5" class="form-label">Address</label>
                            <textarea type="text" name="address" class="form-control" id="RDCFee" required></textarea>
                        </div>

                        <div class="col-md-12">
                            <label for="inputName5" class="form-label">National Id Copy</label>
                            <input type="file" name="file" class="form-control" id="file" required>
                        </div>

                        <div class="col-md-12">
                            <label for="inputName5" class="form-label">Fingerprints Copy</label>
                            <input type="file" name="fileb" class="form-control" id="fileb" required>
                        </div>

                        <div class="col-md-12">
                            <label for="inputName5" class="form-label">Form 55</label>
                            <input type="file" name="form55" class="form-control" id="fileb" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div><!-- End Basic Modal-->
@if (queryStagePanel != null)
{
    <div class="modal fade" id="editManagerModal" tabindex="-1" aria-labelledby="editManagerModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <form asp-controller="License" asp-action="UpdateManager" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="Id" id="editManagerId" />
                    <input type="hidden" name="ApplicationId" value="@ViewBag.ApplicationInfo.Id" />
                    <input type="hidden" name="queryMode" value="true" />
                    <div class="modal-header">
                        <div>
                            <h5 class="modal-title" id="editManagerModalLabel">Update manager information</h5>
                            <small class="text-muted">Leave a document field empty to keep the current file.</small>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="editManagerName">Name</label>
                                <input class="form-control" id="editManagerName" name="Name" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="editManagerSurname">Surname</label>
                                <input class="form-control" id="editManagerSurname" name="Surname" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="editManagerNationalId">National ID</label>
                                <input class="form-control" id="editManagerNationalId" name="NationalId" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="editManagerAddress">Address</label>
                                <input class="form-control" id="editManagerAddress" name="Address" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="editManagerNatIdFile">Replace national ID copy</label>
                                <input class="form-control" id="editManagerNatIdFile" type="file" name="file" accept=".pdf,.jpg,.jpeg,.png" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="editManagerFingerprints">Replace fingerprints</label>
                                <input class="form-control" id="editManagerFingerprints" type="file" name="fileb" accept=".pdf,.jpg,.jpeg,.png" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="editManagerForm55">Replace Form 55</label>
                                <input class="form-control" id="editManagerForm55" type="file" name="form55" accept=".pdf,.jpg,.jpeg,.png" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save manager updates</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
<!-- Get User Modal -->
<div class="modal fade" id="getUserModal" tabindex="-1" aria-labelledby="getUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form id="managerLookupForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ApplicationId" value="@ViewBag.ApplicationInfo.Id">
                <input type="hidden" name="SourceType" id="managerLookupSourceType">
                <input type="hidden" name="SourceId" id="managerLookupSourceId">
                <input type="hidden" name="NationalId" id="managerLookupNationalId">

                <div class="modal-header">
                    <div>
                        <h5 class="modal-title" id="getUserModalLabel">Get Manager Information</h5>
                        <small class="text-muted">Searches managers, directors, then registered users.</small>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="max-height: calc(100vh - 210px); overflow-y: auto; -webkit-overflow-scrolling: touch;">
                    <label for="manid" class="form-label">National ID Number</label>
                    <div class="input-group">
                        <input type="text"
                               name="manid"
                               id="manid"
                               class="form-control"
                               autocomplete="off"
                               placeholder="Spaces and special characters are optional"
                               required>
                        <button id="btnGetUser" type="button" class="btn btn-primary">
                            Search
                        </button>
                    </div>

                    <div id="managerLookupFeedback" class="alert d-none mt-3 mb-0" role="alert"></div>

                    <div id="managerLookupResult" class="d-none mt-4">
                        <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                            <h6 class="mb-0">Matching Details</h6>
                            <span id="managerLookupSourceLabel" class="badge bg-info text-dark"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="managerLookupName" class="form-label">Name</label>
                                <input type="text" id="managerLookupName" class="form-control" readonly>
                            </div>
                            <div class="col-md-6">
                                <label for="managerLookupSurname" class="form-label">Surname</label>
                                <input type="text" id="managerLookupSurname" class="form-control" readonly>
                            </div>
                            <div class="col-md-6">
                                <label for="managerLookupDisplayNationalId" class="form-label">National ID</label>
                                <input type="text" id="managerLookupDisplayNationalId" class="form-control" readonly>
                            </div>
                            <div class="col-md-6">
                                <label for="managerLookupAddress" class="form-label">Address</label>
                                <textarea id="managerLookupAddress" class="form-control" rows="2" readonly></textarea>
                            </div>
                        </div>

                        <hr class="my-4">
                        <h6>Supporting Documents</h6>
                        <p class="small text-muted">Existing documents will be copied. Upload only the documents marked as missing.</p>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="border rounded p-3 h-100">
                                    <div class="fw-semibold mb-2">National ID Copy</div>
                                    <div id="managerLookupNatIdStatus" class="small mb-3"></div>
                                    <div id="managerLookupNatIdUpload" class="d-none">
                                        <input type="file" name="NatIdCopy" id="managerLookupNatIdFile" class="form-control" accept=".pdf,.jpg,.jpeg,.png">
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="border rounded p-3 h-100">
                                    <div class="fw-semibold mb-2">Fingerprints</div>
                                    <div id="managerLookupFingerprintsStatus" class="small mb-3"></div>
                                    <div id="managerLookupFingerprintsUpload" class="d-none">
                                        <input type="file" name="Fingerprints" id="managerLookupFingerprintsFile" class="form-control" accept=".pdf,.jpg,.jpeg,.png">
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="border rounded p-3 h-100">
                                    <div class="fw-semibold mb-2">Form 55</div>
                                    <div id="managerLookupForm55Status" class="small mb-3"></div>
                                    <div id="managerLookupForm55Upload" class="d-none">
                                        <input type="file" name="Form55" id="managerLookupForm55File" class="form-control" accept=".pdf,.jpg,.jpeg,.png">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-dismiss="modal">Close</button>
                    <button type="submit" id="confirmManagerLookup" class="btn btn-success d-none">Confirm and Add Manager</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    const editManagerModal = document.getElementById("editManagerModal");
    if (editManagerModal) {
        editManagerModal.addEventListener("show.bs.modal", function (event) {
            const button = event.relatedTarget;
            if (!button) return;

            document.getElementById("editManagerId").value = button.getAttribute("data-manager-id") || "";
            document.getElementById("editManagerName").value = button.getAttribute("data-manager-name") || "";
            document.getElementById("editManagerSurname").value = button.getAttribute("data-manager-surname") || "";
            document.getElementById("editManagerNationalId").value = button.getAttribute("data-manager-national-id") || "";
            document.getElementById("editManagerAddress").value = button.getAttribute("data-manager-address") || "";
        });
    }

    document.addEventListener("DOMContentLoaded", function () {
        if (!window.jQuery) {
            return;
        }

        var $ = window.jQuery;
        var applicationId = "@ViewBag.ApplicationInfo.Id";
        var lookupUrl = "@Url.Action("ManDetails", "License")";
        var confirmUrl = "@Url.Action("ConfirmManager", "License")";

        function responseMessage(xhr, fallback) {
            return xhr.responseJSON && xhr.responseJSON.message
                ? xhr.responseJSON.message
                : fallback;
        }

        function showFeedback(message, type) {
            $("#managerLookupFeedback")
                .removeClass("d-none alert-info alert-success alert-warning alert-danger")
                .addClass("alert-" + type)
                .text(message);
        }

        function resetLookupResult() {
            $("#managerLookupResult").addClass("d-none");
            $("#confirmManagerLookup").addClass("d-none").prop("disabled", false).text("Confirm and Add Manager");
            $("#managerLookupSourceType, #managerLookupSourceId, #managerLookupNationalId").val("");
            $("#managerLookupNatIdFile, #managerLookupFingerprintsFile, #managerLookupForm55File")
                .val("")
                .prop("required", false);
        }

        function configureDocument(statusSelector, uploadSelector, inputSelector, url, label) {
            var status = $(statusSelector).empty();
            var upload = $(uploadSelector);
            var input = $(inputSelector);

            if (url) {
                $("<a>", {
                    href: url,
                    target: "_blank",
                    rel: "noopener",
                    text: "View existing " + label
                }).appendTo(status);
                upload.addClass("d-none");
                input.val("").prop("required", false);
            } else {
                $("<span>", {
                    class: "badge bg-warning text-dark",
                    text: "Missing — upload required"
                }).appendTo(status);
                upload.removeClass("d-none");
                input.prop("required", true);
            }
        }

        function displayMatch(match) {
            $("#managerLookupSourceType").val(match.sourceType);
            $("#managerLookupSourceId").val(match.sourceId);
            $("#managerLookupNationalId").val(match.nationalId || "");
            $("#managerLookupSourceLabel").text(match.sourceLabel || "Matched record");
            $("#managerLookupName").val(match.name || "");
            $("#managerLookupSurname").val(match.surname || "");
            $("#managerLookupDisplayNationalId").val(match.nationalId || "");
            $("#managerLookupAddress").val(match.address || "");

            var documents = match.documents || {};
            configureDocument(
                "#managerLookupNatIdStatus",
                "#managerLookupNatIdUpload",
                "#managerLookupNatIdFile",
                documents.natIdCopyUrl,
                "National ID Copy");
            configureDocument(
                "#managerLookupFingerprintsStatus",
                "#managerLookupFingerprintsUpload",
                "#managerLookupFingerprintsFile",
                documents.fingerprintsUrl,
                "Fingerprints");
            configureDocument(
                "#managerLookupForm55Status",
                "#managerLookupForm55Upload",
                "#managerLookupForm55File",
                documents.form55Url,
                "Form 55");

            $("#managerLookupResult").removeClass("d-none");
            if (match.profileComplete) {
                $("#confirmManagerLookup").removeClass("d-none");
                showFeedback("Matching details found. Review the information and provide any missing documents.", "success");
            } else {
                $("#confirmManagerLookup").addClass("d-none");
                showFeedback("A matching record was found, but its name, surname, National ID or address is incomplete.", "warning");
            }
        }

        function searchManager() {
            var nationalId = $.trim($("#manid").val());
            resetLookupResult();

            if (!nationalId) {
                showFeedback("Enter a National ID number.", "warning");
                $("#manid").trigger("focus");
                return;
            }

            var searchButton = $("#btnGetUser");
            searchButton.prop("disabled", true).text("Searching…");
            showFeedback("Searching managers, directors and users…", "info");

            $.ajax({
                type: "GET",
                url: lookupUrl,
                dataType: "json",
                data: {
                    nationalid: nationalId,
                    applicationId: applicationId
                }
            }).done(function (response) {
                displayMatch(response.match);
            }).fail(function (xhr) {
                showFeedback(responseMessage(xhr, "No matching manager details were found."), "danger");
            }).always(function () {
                searchButton.prop("disabled", false).text("Search");
            });
        }

        $("#btnGetUser").on("click", searchManager);

        $("#manid").on("keydown", function (event) {
            if (event.key === "Enter") {
                event.preventDefault();
                searchManager();
            }
        });

        $("#managerLookupForm").on("submit", function (event) {
            event.preventDefault();

            if ($("#confirmManagerLookup").hasClass("d-none")) {
                searchManager();
                return;
            }

            if (!this.checkValidity()) {
                this.reportValidity();
                return;
            }

            var confirmButton = $("#confirmManagerLookup");
            confirmButton.prop("disabled", true).text("Adding Manager…");
            showFeedback("Saving the manager details and documents…", "info");

            $.ajax({
                type: "POST",
                url: confirmUrl,
                data: new FormData(this),
                processData: false,
                contentType: false,
                dataType: "json"
            }).done(function (response) {
                showFeedback(response.message, "success");
                confirmButton.addClass("d-none");
                window.setTimeout(function () {
                    window.location.reload();
                }, 700);
            }).fail(function (xhr) {
                showFeedback(responseMessage(xhr, "Unable to add the manager details."), "danger");
                confirmButton.prop("disabled", false).text("Confirm and Add Manager");
            });
        });

        $("#getUserModal").on("hidden.bs.modal", function () {
            resetLookupResult();
            $("#managerLookupFeedback").addClass("d-none").text("");
            $("#manid").val("");
        });
    });
</script>
