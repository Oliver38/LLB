            <div class="modal-header">
                <h5 class="modal-title">Delete Director</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="deleteDirectorId">
                <p class="mb-0">Delete <strong id="deleteDirectorName"></strong> and their uploaded documents?</p>
                <div id="deleteDirectorFeedback" class="alert alert-danger d-none mt-3" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteDirector">Delete Director</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        if (!window.jQuery) {
            return;
        }

        var $ = window.jQuery;

        function showDirectorModal(modalId) {
            var modalElement = document.getElementById(modalId);
            var modalConstructor = window.bootstrap && window.bootstrap.Modal;

            if (modalConstructor && typeof modalConstructor.getOrCreateInstance === "function") {
                window.bootstrap.Modal.getOrCreateInstance(modalElement).show();
            } else if ($.fn && typeof $.fn.modal === "function") {
                $(modalElement).modal("show");
            }
        }

        function hideDirectorModal(modalId) {
            var modalElement = document.getElementById(modalId);
            var modalConstructor = window.bootstrap && window.bootstrap.Modal;

            if (modalConstructor && typeof modalConstructor.getOrCreateInstance === "function") {
                window.bootstrap.Modal.getOrCreateInstance(modalElement).hide();
            } else if ($.fn && typeof $.fn.modal === "function") {
                $(modalElement).modal("hide");
            }
        }

        function ajaxMessage(xhr, fallback) {
            return xhr.responseJSON && xhr.responseJSON.message
                ? xhr.responseJSON.message
                : fallback;
        }

        function showPageAlert(message, isSuccess) {
            var alert = $("#directorActionAlert");
            alert.removeClass("d-none alert-success alert-danger")
                .addClass(isSuccess ? "alert-success" : "alert-danger")
                .text(message);
        }

        function setModalFeedback(message, isError) {
            var feedback = $("#editDirectorFeedback");
            if (!message) {
                feedback.addClass("d-none").text("");
                return;
            }

            feedback.removeClass("d-none alert-info alert-danger")
                .addClass(isError ? "alert-danger" : "alert-info")
                .text(message);
        }

        function setDocumentStatus(selector, url, label) {
            var container = $(selector).empty();
            if (url) {
                $("<a>", {
                    href: url,
                    target: "_blank",
                    rel: "noopener",
                    text: "Current " + label
                }).appendTo(container);
            } else {
                $("<span>", {
                    class: "badge bg-warning text-dark",
                    text: "Missing — please upload"
                }).appendTo(container);
            }
        }

        function renderDocumentCell(cell, url, label) {
            var container = $(cell).empty();
            if (url) {
                $("<a>", {
                    href: url,
                    target: "_blank",
                    rel: "noopener",
                    text: label
                }).appendTo(container);
            } else {
                $("<span>", {
                    class: "badge bg-warning text-dark",
                    text: "Missing — upload required"
                }).appendTo(container);
            }
        }

        function populateDirectorModal(director) {
            $("#editDirectorId").val(director.id);
            $("#editDirectorName").val(director.name || "");
            $("#editDirectorSurname").val(director.surname || "");
            $("#editDirectorNationalId").val(director.nationalId || "");
            $("#editDirectorAddress").val(director.address || "");
            $("#editDirectorNatIdCopy, #editDirectorFingerprints, #editDirectorForm55").val("");

            var documents = director.documents || {};
            setDocumentStatus("#editDirectorNatIdStatus", documents.natIdCopyUrl, "National ID Copy");
            setDocumentStatus("#editDirectorFingerprintsStatus", documents.fingerprintsUrl, "Fingerprints");
            setDocumentStatus("#editDirectorForm55Status", documents.form55Url, "Form 55");
        }

        function updateDirectorRow(director) {
            var row = $('#directorTableBody tr[data-director-id="' + director.id + '"]');
            var documents = director.documents || {};

            row.find(".director-name").text(director.name || "");
            row.find(".director-surname").text(director.surname || "");
            row.find(".director-national-id").text(director.nationalId || "");
            row.find(".director-address").text(director.address || "");
            row.find(".js-delete-director").attr("data-director-name", ((director.name || "") + " " + (director.surname || "")).trim());

            renderDocumentCell(row.find(".director-natid-copy"), documents.natIdCopyUrl, "National ID Copy");
            renderDocumentCell(row.find(".director-fingerprints"), documents.fingerprintsUrl, "Fingerprints");
            renderDocumentCell(row.find(".director-form55"), documents.form55Url, "Form 55");
        }

        $(document).on("click", ".js-edit-director", function () {
            var directorId = $(this).data("director-id");
            setModalFeedback("Loading director details…", false);
            $("#editDirectorForm :input").prop("disabled", true);
            showDirectorModal("editDirectorModal");

            $.ajax({
                url: "/License/directors/" + encodeURIComponent(directorId),
                type: "GET",
                dataType: "json"
            }).done(function (response) {
                populateDirectorModal(response.director);
                setModalFeedback("", false);
                $("#editDirectorForm :input").prop("disabled", false);
            }).fail(function (xhr) {
                setModalFeedback(ajaxMessage(xhr, "Unable to load the director details."), true);
                $("#editDirectorForm :input").prop("disabled", false);
            });
        });

        $("#editDirectorForm").on("submit", function (event) {
            event.preventDefault();
            if (!this.checkValidity()) {
                this.reportValidity();
                return;
            }

            var directorId = $("#editDirectorId").val();
            var formData = new FormData(this);
            var saveButton = $("#saveDirectorChanges");
            saveButton.prop("disabled", true).text("Saving…");
            setModalFeedback("Saving director details and documents…", false);

            $.ajax({
                url: "/License/directors/" + encodeURIComponent(directorId),
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                dataType: "json"
            }).done(function (response) {
                updateDirectorRow(response.director);
                showPageAlert(response.message, true);
                hideDirectorModal("editDirectorModal");
            }).fail(function (xhr) {
                setModalFeedback(ajaxMessage(xhr, "Unable to update the director."), true);
            }).always(function () {
                saveButton.prop("disabled", false).text("Save Director");
            });
        });

        $(document).on("click", ".js-delete-director", function () {
            $("#deleteDirectorId").val($(this).data("director-id"));
            $("#deleteDirectorName").text($(this).attr("data-director-name") || "this director");
            $("#deleteDirectorFeedback").addClass("d-none").text("");
            showDirectorModal("deleteDirectorModal");
        });

        $("#confirmDeleteDirector").on("click", function () {
            var directorId = $("#deleteDirectorId").val();
            var deleteButton = $(this);
            deleteButton.prop("disabled", true).text("Deleting…");

            $.ajax({
                url: "/License/directors/" + encodeURIComponent(directorId),
                type: "DELETE",
                dataType: "json"
            }).done(function (response) {
                $('#directorTableBody tr[data-director-id="' + directorId + '"]').remove();
                hideDirectorModal("deleteDirectorModal");
                showPageAlert(response.message, true);

                if ($("#directorTableBody tr").length === 0) {
                    $("#directorTableContainer").replaceWith(
                        '<div id="directorTableContainer" class="alert alert-warning">No director details have been added.</div>'
                    );
                }
            }).fail(function (xhr) {
                $("#deleteDirectorFeedback")
                    .removeClass("d-none")
                    .text(ajaxMessage(xhr, "Unable to delete the director."));
            }).always(function () {
                deleteButton.prop("disabled", false).text("Delete Director");
            });
        });
    });
</script>







