<script>
    (function () {
        function syncHotelRoomFields() {
            var licenseSelect = document.querySelector(".license-type-select");
            var selectedOption = licenseSelect ? licenseSelect.options[licenseSelect.selectedIndex] : null;
            var licenseName = selectedOption ? (selectedOption.getAttribute("data-license-name") || selectedOption.text || "") : "";
            var isHotel = licenseName.toLowerCase().indexOf("hotel") >= 0;

            document.querySelectorAll(".hotel-room-section").forEach(function (section) {
                section.classList.toggle("d-none", !isHotel);
            });

            document.querySelectorAll(".hotel-room-input").forEach(function (input) {
                input.disabled = !isHotel;
                if (!isHotel) {
                    input.value = "";
                }
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            var licenseSelect = document.querySelector(".license-type-select");
            if (licenseSelect) {
                licenseSelect.addEventListener("change", syncHotelRoomFields);
                syncHotelRoomFields();
            }
        });
    })();
</script>


