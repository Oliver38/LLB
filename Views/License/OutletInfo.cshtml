                            {
                                <option value="@provinces.Name">@provinces.Name</option>
                            }
                        </select>

                    </div>

                    <div class="col-md-6">
                        <label for="inputName5" class="form-label">District</label>
                        <select type="text" required name="city" value="" class="form-control" id="districtSelect"></select>
                    </div>


                    @*<div class="col-md-6">
                                            <label for="inputName5" class="form-label">Town Council</labe            l>
                                <select type="text" name="council" value="" class="form-control" id="co          uncilSelect"id="councilSelect" />
                        </div>*@
                    <div class="col-md-6">
                        <label for="councilSelect" class="form-label">Council</label>
                        <select id="councilSelect" required onchange="getRegion()" value="" name="council" class="form-control"></select>
                    </div>
                    <div class="text-center">
                        <button type="submit" class="btn btn-primary">Submit</button>
                        <button type="reset" class="btn btn-secondary">Reset</button>
                    </div>
                </form><!-- End Multi Columns Form -->


                <div id="directorActionAlert" class="alert d-none mt-3" role="alert"></div>
                @if (ViewBag.DirectorsCount <= 0)
                {
                    if (@ViewBag.Application.ApplicantType == "Individual") { }
                    else
                    {

                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addDirector">Add Director </button>
                    }
                }
                else
                {


                    <div class="table-responsive" id="directorTableContainer">
                        <table class="table table-hover table-striped align-middle" id="directorTable">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Surname</th>
                                    <th>National ID</th>
                                    <th>Address</th>
                                    <th>ID Copy</th>
                                    <th>Fingerprints</th>
                                    <th>Form 55</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="directorTableBody">
                                @foreach (var director in ViewBag.Directors)
                                {
                                    <tr data-director-id="@director.Id">
                                        <td class="director-name">@director.Name</td>
                                        <td class="director-surname">@director.Surname</td>
                                        <td class="director-national-id">@director.NationalId</td>
                                        <td class="director-address">@director.Address</td>
                                        <td class="director-natid-copy">
                                            @if (string.IsNullOrWhiteSpace(director.NatId))
                                            {<span class="badge bg-warning text-dark">Missing — upload required</span>}
                                            else
                                            {<a target="_blank" href="~/@director.NatId">National ID Copy</a>}
                                        </td>
                                        <td class="director-fingerprints">
                                            @if (string.IsNullOrWhiteSpace(director.FingerPrints))
                                            {<span class="badge bg-warning text-dark">Missing — upload required</span>}
                                            else
                                            {<a target="_blank" href="~/@director.FingerPrints">Fingerprints</a>}
                                        </td>
                                        <td class="director-form55">
                                            @if (string.IsNullOrWhiteSpace(director.Form55))
                                            {<span class="badge bg-warning text-dark">Missing — upload required</span>}
                                            else
                                            {<a target="_blank" href="~/@director.Form55">Form 55</a>}
                                        </td>
                                        <td class="text-nowrap">
                                            <button type="button" class="btn btn-sm btn-outline-primary js-edit-director" data-director-id="@director.Id">Edit / Upload</button>
                                            <button type="button" class="btn btn-sm btn-outline-danger js-delete-director" data-director-id="@director.Id" data-director-name="@director.Name @director.Surname">Delete</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    if (@ViewBag.Application.ApplicantType == "Individual") { }
                    else
                    {
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addDirector">Add Director </button>

                    }

                }
                <div class="card-footer">
                    <div class="text-center">
                        <a href="/License/Apply?Id=@ViewBag.Application.Id" class="btn btn-warning">Prev</a>

                    </div>
                </div>
            </div>
        </div>

    </div>





}
