<div class="modal fade" id="addDirector" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Adding Director Details </h5> <h5 class="modal-title" id="feetitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/License/Director" enctype="multipart/form-data" method="post">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <label for="inputName5" class="form-label">Name</label>
                            <input type="hidden" name="applicationId" class="form-control" value="@ViewBag.Application.Id" id="Id">
                            <input type="text" required name="name" class="form-control" id="name">
                        </div>
                        <div class="col-md-6">
                            <label for="inputName5" class="form-label">Surname</label>
                            <input type="text" required name="surname" class="form-control" id="surname">
                        </div>
                        <div class="col-md-12">
                            <label for="inputName5" class="form-label">National Id</label>
                            <input type="text" required name="nationalId" class="form-control" id="TownFee">
                        </div>
                        <div class="col-md-12">
                            <label for="inputName5" class="form-label">Address</label>
                            <textarea type="text" required name="address" class="form-control" id="RDCFee"></textarea>
                        </div>

                        
                        <div class="col-md-12">
                            <label for="inputName5" class="form-label">National Id Copy</label>
                            <input type="file"  required name="natid" class="form-control" id="TownFee">
                        </div>

                        <div class="col-md-12">
                            <label for="inputName5" class="form-label">Fingerprints</label>
                            <input type="file" required name="fingerprints" class="form-control" id="TownFee">
                        </div>

                        <div class="col-md-12">
                            <label for="inputName5" class="form-label">Form 55</label>
                            <input type="file" required name="form" class="form-control" id="TownFee">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div><!-- End Basic Modal-->

<div class="modal fade" id="editDirectorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Director and Upload Documents</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editDirectorForm" enctype="multipart/form-data">
                <div class="modal-body">
                    <input type="hidden" id="editDirectorId">
                    <div id="editDirectorFeedback" class="alert d-none" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="editDirectorName" class="form-label">Name</label>
                            <input type="text" class="form-control" id="editDirectorName" name="Name" required>
                        </div>
                        <div class="col-md-6">
                            <label for="editDirectorSurname" class="form-label">Surname</label>
                            <input type="text" class="form-control" id="editDirectorSurname" name="Surname" required>
                        </div>
                        <div class="col-md-6">
                            <label for="editDirectorNationalId" class="form-label">National ID</label>
                            <input type="text" class="form-control" id="editDirectorNationalId" name="NationalId" required>
                        </div>
                        <div class="col-md-6">
                            <label for="editDirectorAddress" class="form-label">Address</label>
                            <textarea class="form-control" id="editDirectorAddress" name="Address" rows="2" required></textarea>
                        </div>

                        <div class="col-md-4">
                            <label for="editDirectorNatIdCopy" class="form-label">National ID Copy</label>
                            <div id="editDirectorNatIdStatus" class="small mb-2"></div>
                            <input type="file" class="form-control" id="editDirectorNatIdCopy" name="NatIdCopy" accept=".pdf,.jpg,.jpeg,.png">
                        </div>
                        <div class="col-md-4">
                            <label for="editDirectorFingerprints" class="form-label">Fingerprints</label>
                            <div id="editDirectorFingerprintsStatus" class="small mb-2"></div>
                            <input type="file" class="form-control" id="editDirectorFingerprints" name="Fingerprints" accept=".pdf,.jpg,.jpeg,.png">
                        </div>
                        <div class="col-md-4">
                            <label for="editDirectorForm55" class="form-label">Form 55</label>
                            <div id="editDirectorForm55Status" class="small mb-2"></div>
                            <input type="file" class="form-control" id="editDirectorForm55" name="Form55" accept=".pdf,.jpg,.jpeg,.png">
                        </div>
                    </div>
                    <p class="text-muted small mt-3 mb-0">PDF, JPG and PNG files are accepted. Existing documents remain unchanged unless a replacement is selected.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="saveDirectorChanges">Save Director</button>
                </div>
            </form>
        </div>
    </div>
</div>

