@{
    Layout = "_LayoutMain";

    string currentLicenseName = string.Empty;
    if (ViewBag.Application != null && ViewBag.License != null)
    {
        foreach (var license in ViewBag.License)
        {
            if (license.Id == ViewBag.Application.LicenseTypeID)
            {
                currentLicenseName = license.LicenseName ?? string.Empty;
                break;
            }
        }
    }

    var showHotelRooms = currentLicenseName.IndexOf("hotel", StringComparison.OrdinalIgnoreCase) >= 0;
}

@{ var queryStagePanel = ViewBag.QueryStagePanel as LLB.Models.ViewModel.ApplicantQueryStagePanelViewModel; }
@if (queryStagePanel != null)
{
    @await Html.PartialAsync("_ApplicantQueryStagePanel", queryStagePanel)
}


@if (ViewBag.OutletInfo == null)
{
    <div class="row">
        <div class="card">
            <div class="card-body" id="_step1">
                <h5 class="card-title">Outlet Information</h5>

                <!-- Multi Columns Form -->
                <form action="/License/OutletInfo" method="post" enctytpe="multipart/form-data" class="row g-3">

                    <input type="hidden" name="queryMode" value="@(queryStagePanel != null ? "true" : "false")" />


                    <div class="col-md-12">
                        <label for="inputName5" class="form-label">Trading Name</label>
                        <input type="text" required name="tradingName" value="" class="form-control" id="inputName5">
                        <input type="hidden" required name="ApplicationId" value="@ViewBag.Application.Id" class="form-control" id="inputName5">
                    </div>
                    <div class="col-md-12">
                        <div id="map" style="height: 400px; border-radius: 10px;"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Latitude</label>
                        <input type="text" id="latitude"  name="latitude" class="form-control" placeholder="Latitude">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Longitude</label>
                        <input type="text" id="longitude" name="longitude" class="form-control" placeholder="Longitude">
                    </div>

                    <div class="col-md-6">
                        <label for="inputName5" class="form-label">Licence Type</label>
                        <select type="text" required name="LicenseTypeID" value="" class="form-control license-type-select" id="LicenseTypeID">
                            <option value=""> --Select License-- </option>

                            @foreach (var licensetype in ViewBag.License)
                            {
                                @if (licensetype.LicenseName == "Managers Fees") { }
                                else
                                {
                                    <option value="@licensetype.Id" data-license-name="@licensetype.LicenseName">@licensetype.LicenseName </option>

                                }
                            }
                        </select>
                    </div>


                    <div class="col-md-6">
                        <label for="inputName5" class="form-label">Location of Premises</label>
